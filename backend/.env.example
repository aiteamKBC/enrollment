# Enrolment Corner only. Both Django aliases resolve to this one database.
DATABASE_URL=postgresql://USER:PASSWORD@ENROLMENT_CORNER_HOST/neondb?sslmode=require
ENROLLMENT_DATABASE_HOST=ENROLMENT_CORNER_HOST
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SYSTEM_TIME_ZONE=Europe/London
LMS_URL=https://your-existing-lms.example
LMS_HANDOFF_URL=https://your-private-lms-receiver.example/handoff
LMS_HANDOFF_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_ON_BOTH_SERVICES
API_REQUIRE_AUTH=1
ENROLMENT_API_REQUIRE_AUTH=1
CURRICULUM_WARM=0
ENGLAND_HOLIDAY_AUTO_SYNC=0
CURRICULUM_ALLOW_RUNTIME_SCHEMA_BOOTSTRAP=false

# Required for private evidence and signed documents. Keep existing references.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_ENROLMENT_DOCS_CONTAINER=enrolment-docs
AZURE_QUARANTINE_CONTAINER=evidence-quarantine
AZURE_APPROVED_CONTAINER=evidence-approved
AZURE_REJECTED_CONTAINER=evidence-rejected
AZURE_SAS_TTL_MINUTES=15

# Invitations/password resets. Enable after configuring the service's URL.
AZURE_MAIL_ENABLED=false
AZURE_MAIL_TENANT_ID=
AZURE_MAIL_CLIENT_ID=
AZURE_MAIL_CLIENT_SECRET=
AZURE_MAIL_SENDER=

# First-session Teams booking. Dedicated app-only Graph credentials.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=

# Optional Microsoft sign-in; register this service callback separately.
MICROSOFT_SSO_TENANT_ID=
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=
MICROSOFT_SSO_CALLBACK_URI=http://localhost:3001/login_api/microsoft/callback/

# Optional Inclusion step integration.
SUPPORT_TICKETS_DATABASE_URL=
INCLUSION_SSO_CALLBACK_URL=
INCLUSION_SSO_SECRET=
